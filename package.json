{
  "name": "ctfpawned",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "description": "Twelve browser-only web-security puzzles wrapped in a cat adoption agency story.",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:targets && pnpm content:check && astro build",
    "build:targets": "node scripts/build-targets.mjs",
    "preview": "astro preview",
    "serve:dist": "node scripts/serve-dist.mjs",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:check": "node scripts/check-content.mjs",
    "flag": "node scripts/make-flag.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.5",
    "@nanostores/persistent": "1.3.5",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.1",
    "nanostores": "1.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "3.1.0",
    "jose": "6.2.8",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sql.js": "1.14.1",
    "svgo": "4.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
