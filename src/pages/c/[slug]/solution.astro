---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import {
  getChallengeBySlug,
  getVisibleChallenges,
} from "../../../lib/challenges";

const solutionModules = import.meta.glob<{ default: AstroComponentFactory }>(
  "../../../challenges/*/solution.mdx",
  { eager: true },
);

export function getStaticPaths() {
  return getVisibleChallenges(!import.meta.env.PROD).map((challenge) => ({
    params: { slug: challenge.slug },
  }));
}

const { slug } = Astro.params;
const challenge = slug
  ? getChallengeBySlug(slug, !import.meta.env.PROD)
  : undefined;

if (!challenge) {
  return Astro.redirect("/");
}

const Solution =
  solutionModules[`../../../challenges/${challenge.slug}/solution.mdx`]
    ?.default;
---

<BaseLayout
  title={`${challenge.cat}: solution write-up | ctfpawned`}
  description={`${challenge.cat} solution write-up for ${challenge.vulnClass}.`}
>
  <section class="page">
    <div class={`hero challenge-hero challenge-card-act-${challenge.act}`}>
      <div>
        <h1>{challenge.cat}: solution write-up</h1>
        <p>
          Walkthrough, production fix, and recovered story notes for {
            challenge.vulnClass
          }.
        </p>
        <div class="challenge-meta">
          <span class="tag">Act {challenge.act}</span>
          <span class="tag">Difficulty {challenge.difficulty}</span>
          <span class="tag">{challenge.vulnClass}</span>
        </div>
      </div>
    </div>
    <section
      class="solution-gate"
      data-solution-gate
      data-slug={challenge.slug}
    >
      <div class="content-panel" data-solution-prompt>
        <h2>Show solution?</h2>
        <p>
          Revealing this page marks the challenge as given up in local progress.
        </p>
        <button class="danger-action" type="button" data-solution-reveal>
          Show me anyway
        </button>
      </div>
      <article
        class="content-panel solution-content"
        data-solution-content
        hidden
      >
        {Solution ? <Solution /> : <p>Challenge solution is missing.</p>}
      </article>
    </section>
    <nav class="solution-nav" aria-label="Solution navigation">
      <a class="secondary-action" href={`/c/${challenge.slug}/`}>
        Back to challenge
      </a>
      <a class="secondary-action" href="/writeups/">All write-ups</a>
    </nav>
  </section>
</BaseLayout>
