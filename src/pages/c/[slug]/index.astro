---
import ChallengeFrame from "../../../components/ChallengeFrame.astro";
import FlagCheck from "../../../components/FlagCheck.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import {
  getChallengeBySlug,
  getVisibleChallenges,
} from "../../../lib/challenges";

const briefModules = import.meta.glob<{ default: AstroComponentFactory }>(
  "../../../challenges/*/brief.mdx",
  { eager: true },
);
const hintModules = import.meta.glob<{ default: AstroComponentFactory }>(
  "../../../challenges/*/hints.mdx",
  { eager: true },
);

export function getStaticPaths() {
  return getVisibleChallenges(!import.meta.env.PROD).map((challenge) => ({
    params: { slug: challenge.slug },
  }));
}

const { slug } = Astro.params;
const challenge = slug
  ? getChallengeBySlug(slug, !import.meta.env.PROD)
  : undefined;

if (!challenge) {
  return Astro.redirect("/");
}

const Brief =
  briefModules[`../../../challenges/${challenge.slug}/brief.mdx`]?.default;
const Hints =
  hintModules[`../../../challenges/${challenge.slug}/hints.mdx`]?.default;
---

<BaseLayout
  title={`${challenge.cat}: ${challenge.title} | ctfpawned`}
  description={challenge.tagline}
>
  <section class="page">
    <div class="hero">
      <h1>{challenge.cat}</h1>
      <p>{challenge.tagline}</p>
    </div>
    <ChallengeFrame
      slug={challenge.slug}
      title={`${challenge.cat}: ${challenge.title}`}
      frameHeight={challenge.frameHeight}
    />
    <FlagCheck slug={challenge.slug} flagHash={challenge.flagHash} />
    <article class="content-panel">
      {Brief ? <Brief /> : <p>Challenge brief is missing.</p>}
    </article>
    <article class="content-panel">
      <h2>Hints</h2>
      {Hints ? <Hints /> : <p>Challenge hints are missing.</p>}
    </article>
  </section>
</BaseLayout>
