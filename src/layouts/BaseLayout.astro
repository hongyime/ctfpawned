---
import "../styles/tokens.css";
import {
  absoluteUrl,
  SITE_DESCRIPTION,
  SITE_IMAGE_PATH,
  SITE_TITLE,
} from "../lib/site";

type Props = {
  title?: string;
  description?: string;
};

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
const canonicalUrl = absoluteUrl(Astro.url.pathname);
const imageUrl = absoluteUrl(SITE_IMAGE_PATH);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="Canvas" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="ctfpawned browser security puzzle roster"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <script is:inline type="module" src="/shell.js"></script>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <nav class="site-nav" aria-label="Main navigation">
          <a class="brand" href="/">ctfpawned</a>
          <div class="nav-links">
            <a href="/">Challenges</a>
            <a href="/primer/">Primer</a>
            <a href="/writeups/">Write-ups</a>
            <a href="/about/">About</a>
          </div>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        Legal scope: use these toy targets only here, or on systems you own or
        have explicit permission to test. Attacking real systems without
        permission is illegal.
      </footer>
    </div>
  </body>
</html>
